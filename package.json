{
  "private": true,
  "name": "@svws-nrw/svws-schulungsunterlagen",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "serve": "vitepress serve",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "lint": "eslint '**/*.{ts,vue,md}' --cache",
    "docs:check-structure": "node scripts/check-structure.mjs",
    "docs:check-navigation": "node --test tests/*.test.mjs",
    "docs:check-built": "node scripts/check-built.mjs",
    "docs:check-content": "node scripts/check-content.mjs",
    "docs:check-browser": "node scripts/check-browser.mjs",
    "docs:check": "npm run docs:check-structure && npm run docs:check-navigation && npm run docs:check-content && npm run docs:build && npm run docs:check-built"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.1.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0-alpha.30",
    "@typescript-eslint/parser": "^8.0.0-alpha.30",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "typescript-eslint": "^8.0.0-alpha.30",
    "vitepress": "^1.6.4",
    "markdown-it-container": "^4.0.0"
  },
  "dependencies": {
    "vitepress-mermaid-renderer": "^1.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
